# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
coverage-*.txt
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Claude Code — personal local settings (credentials, personal permissions)
.claude/settings.local.json
# Claude Code hooks — tracked (all portable via $CLAUDE_PROJECT_DIR)
# MCP local overrides (personal servers, alternate credentials)
.mcp.local.json

# Codex local overrides (personal servers, alternate credentials)
.codex/config.toml

# Chat exports / session logs
chats/

# Private journal (personal MCP server data, never shared)
.private-journal/

# Data (text fixture files, etc.)
.data/

# Git worktrees
.worktrees/
.claude/worktrees/
