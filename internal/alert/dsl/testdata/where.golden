         AND CASE WHEN cap.ecosystem = 'PyPI' THEN regexp_replace(lower(cap.package_name), '[-_.]+', '-', 'g') ELSE lower(cap.package_name) END = CASE WHEN cap.ecosystem = 'PyPI' THEN regexp_replace(lower(wi.package_name), '[-_.]+', '-', 'g') ELSE lower(wi.package_name) END
        WHERE wi.watchlist_id = ANY(?)
          AND wi.org_id       = ?
          AND wi.item_type    = 'package'
          AND wi.deleted_at IS NULL
          AND cap.cve_id      = cves.cve_id
    )
    OR EXISTS (
        SELECT 1 FROM watchlist_items wi
        JOIN cve_affected_cpes cac
          ON cac.cpe_normalized LIKE (wi.cpe_normalized || '%')
        WHERE wi.watchlist_id = ANY(?)
          AND wi.org_id       = ?
          AND wi.item_type    = 'cpe'
          AND wi.deleted_at IS NULL
          AND cac.cve_id      = cves.cve_id
    )
))
