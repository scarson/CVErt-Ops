{{define "subject"}}Verify your CVErt Ops email address{{end}}
{{define "body"}}
<!DOCTYPE html>
<html>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;">
  <h2 style="color: #1a1a2e;">Email Verification</h2>
  <p>Please verify your email address ({{.Email}}) for your CVErt Ops account.</p>
  <p><a href="{{.VerifyURL}}" style="display: inline-block; padding: 12px 24px; background-color: #1a1a2e; color: #ffffff; text-decoration: none; border-radius: 4px;">Verify Email</a></p>
  <p style="color: #666; font-size: 14px;">This link expires in {{.ExpiresIn}}. If you didn't create this account, you can safely ignore this email.</p>
  <p style="color: #999; font-size: 12px;">If the button doesn't work, copy this URL: {{.VerifyURL}}</p>
</body>
</html>
{{end}}
