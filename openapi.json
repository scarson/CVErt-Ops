    "/cves": {
      "get": {
        "description": "Paginated CVE search with full-text search, facet filters, and keyset pagination.",
        "operationId": "list-cves",
        "parameters": [
          {
            "description": "Full-text search query (supports quoted phrases and negation)",
            "explode": false,
            "in": "query",
            "name": "q",
            "schema": {
              "description": "Full-text search query (supports quoted phrases and negation)",
              "type": "string"
            }
          },
          {
            "description": "Filter by severity: critical, high, medium, low, unknown",
            "explode": false,
            "in": "query",
            "name": "severity",
            "schema": {
              "description": "Filter by severity: critical, high, medium, low, unknown",
              "items": {
                "type": "string"
              },
              "type": [
                "array",
                "null"
              ]
            }
          },
          {
            "description": "Filter CVEs modified on or after this date (ISO 8601); empty = no filter",
            "explode": false,
            "in": "query",
            "name": "date_from",
            "schema": {
              "description": "Filter CVEs modified on or after this date (ISO 8601); empty = no filter",
              "type": "string"
            }
          },
          {
            "description": "Filter CVEs modified on or before this date (ISO 8601); empty = no filter",
            "explode": false,
            "in": "query",
            "name": "date_to",
            "schema": {
              "description": "Filter CVEs modified on or before this date (ISO 8601); empty = no filter",
              "type": "string"
            }
          },
          {
            "description": "Filter by CWE ID (e.g. CWE-79); empty = no filter",
            "explode": false,
            "in": "query",
            "name": "cwe_id",
            "schema": {
              "description": "Filter by CWE ID (e.g. CWE-79); empty = no filter",
              "type": "string"
            }
          },
          {
            "description": "Filter by affected package ecosystem; empty = no filter",
            "explode": false,
            "in": "query",
            "name": "ecosystem",
            "schema": {
              "description": "Filter by affected package ecosystem; empty = no filter",
              "type": "string"
            }
          },
          {
            "description": "Filter by affected package name (requires ecosystem); empty = no filter",
            "explode": false,
            "in": "query",
            "name": "package_name",
            "schema": {
              "description": "Filter by affected package name (requires ecosystem); empty = no filter",
              "type": "string"
