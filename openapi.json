            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Log in and receive auth cookies",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "parameters": [
          {
            "description": "Refresh token cookie",
            "in": "cookie",
            "name": "refresh_token",
            "schema": {
              "description": "Refresh token cookie",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
